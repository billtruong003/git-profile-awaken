{
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "node_modules/{@fontsource/chakra-petch/files/chakra-petch-latin-*-normal.woff2,@fontsource/jetbrains-mono/files/jetbrains-mono-latin-*-normal.woff2,harfbuzzjs/dist/harfbuzz-subset.wasm}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ]
}
